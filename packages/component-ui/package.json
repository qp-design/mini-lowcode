{
  "name": "@brushes/lowcode-component-ui",
  "version": "0.0.3",
  "main": "dist/index.js",
  "license": "MIT",
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "scripts": {
    "start": "concurrently npm:start:*",
    "start:ts": "rollup -c -w",
    "start:css": "npx nodemon --config ./nodemon.json",
    "cp-css": "rm -rf css/ && mkdir -p ./css && cp -R src/scss/* ./css",
    "build": "npm run cp-css && rm -rf dist/ && prettier --write src/ && rollup -c",
    "push": "git add . && git commit -m",
    "postpush": "git push",
    "prepublishOnly": "echo 我们准备发布npm包",
    "publishOnly": "npm run build && npm run push",
    "postpublishOnly": "npm version patch && npm publish && git push"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@turbo/gen": "^1.10.12",
    "@types/node": "^20.5.2",
    "@types/react": "^18.2.0",
    "concurrently": "^9.2.1",
    "eslint-config-custom": "*",
    "react": "^18.2.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "tsconfig": "*",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@brushes/simulate-component-mini": "*",
    "@brushes/component-core-mini": "*",
    "@brushes/component-store-web": "*",
    "@brushes/component-tool": "*",
    "@brushes/core-transform-mini": "^1.0.1",
    "classnames": "^2.5.1",
    "nodemon": "^2.0.22"
  }
}
